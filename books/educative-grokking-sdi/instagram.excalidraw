    },
    {
      "id": "WscVNOVPlRhHj_TzR2fxj",
      "type": "text",
      "x": 1397.8207784675192,
      "y": -954.4875807248018,
      "width": 549.7196044921875,
      "height": 825,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1F",
      "roundness": null,
      "seed": 1757138150,
      "version": 1063,
      "versionNonce": 470491034,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1751168039678,
      "link": null,
      "locked": false,
      "text": "Functional:\n* Users can upload/download/view photos or videos\n* Users can search based on titles\n  -- Just keywords; no filters, fuzzy or personalization. \n  -- Sort times & likes\n* Users can follow others\n* Users can view the most recent photos \n  from those they follow\n    - Page through such posts.\n\nNon-Functional:\n* Feed generation should take about ~200ms\n* Prioritize availability thus we'll satisfied with \n  eventual consistency (e.g. 1 min for a post)\n* Scale to 2B DAU\n* Search\n  -- Fast, queries < 500ms\n  -- High volume (TBD)\n  -- Fresh results, posts visible in < 1 minute\n  -- All posts should be available (high recall)\n  -- High availability\n\n\n\n\nBonus (out of scope):\n* Favorite Posts\n* Search: Order by favorite count\n* Adding tags\n* Searching by tags\n* Commenting\n* Tagging users\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional:\n* Users can upload/download/view photos or videos\n* Users can search based on titles\n  -- Just keywords; no filters, fuzzy or personalization. \n  -- Sort times & likes\n* Users can follow others\n* Users can view the most recent photos \n  from those they follow\n    - Page through such posts.\n\nNon-Functional:\n* Feed generation should take about ~200ms\n* Prioritize availability thus we'll satisfied with \n  eventual consistency (e.g. 1 min for a post)\n* Scale to 2B DAU\n* Search\n  -- Fast, queries < 500ms\n  -- High volume (TBD)\n  -- Fresh results, posts visible in < 1 minute\n  -- All posts should be available (high recall)\n  -- High availability\n\n\n\n\nBonus (out of scope):\n* Favorite Posts\n* Search: Order by favorite count\n* Adding tags\n* Searching by tags\n* Commenting\n* Tagging users\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Va22twcd1qHNTwFdjrVte",
      "type": "text",
      "x": 1403.4994722102017,
      "y": -143.73742067029718,
      "width": 564.4194946289062,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1I",
      "roundness": null,
      "seed": 1403981498,
      "version": 635,
      "versionNonce": 471858010,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1751219121604,
      "link": null,
      "locked": false,
      "text": "API's\n\n# Note: Technique = Staged media\n\nPOST /posts {\n  userId\n  comment,  \n  mediaIds[]\n  ..\n}\n\n\nGET /feed?pageSize=[size]&cursor=[cursor] \n* cursor = old timestamp in page\n\nPUT /users/[id]/followers {\n  userId\n}\n\nGet /search?pageSize=[size]&cursor=[cursor]&q=[search]\n  \n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API's\n\n# Note: Technique = Staged media\n\nPOST /posts {\n  userId\n  comment,  \n  mediaIds[]\n  ..\n}\n\n\nGET /feed?pageSize=[size]&cursor=[cursor] \n* cursor = old timestamp in page\n\nPUT /users/[id]/followers {\n  userId\n}\n\nGet /search?pageSize=[size]&cursor=[cursor]&q=[search]\n  \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
