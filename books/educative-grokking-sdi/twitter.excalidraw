      "boundElements": null,
      "updated": 1750015651520,
      "link": null,
      "locked": false,
      "text": "Concerns:\n* We're reading from a multi-partition topic in Kafka and\n   so we may read a post from one user before another if \n   close enough. In Redis we'll use a ZSet instead of a List",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Concerns:\n* We're reading from a multi-partition topic in Kafka and\n   so we may read a post from one user before another if \n   close enough. In Redis we'll use a ZSet instead of a List",
      "autoResize": true,
      "lineHeight": 1.25
    },
